# Copy this file to .env and add your API keys
# Do NOT commit your actual .env file to GitHub

# Select your AI provider (gemini or claude)
AI="gemini"

# Maximum number of successful applications per run
MAX_APPLICATIONS="3"

# Profile to use from the profiles/ directory (filename without .yaml extension)
PROFILE="dummy_profile"

# Optional: Override resume file located in local root directory
# RESUME_PATH="my_resume.pdf"
# RESUME_UNDER1MB_PATH="my_resume.pdf"
GEMINI_MODEL="gemini-2.5-flash"

# Optional: Use Claude instead of Gemini
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
CLAUDE_MODEL="claude-3-5-sonnet-latest"

# Optional: Use Cursor / OpenAI-compatible / OpenRouter API
# Set AI="cursor" above to use this provider as primary
CURSOR_API_KEY="your_cursor_or_openai_api_key_here"
CURSOR_BASE_URL="https://api.cursor.com"
